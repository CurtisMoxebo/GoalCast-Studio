// Prisma Schema for GoalCast Studio
// Database: MariaDB (compatible with mysql provider)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum PredictionGroupStatus {
  PREVIEW
  ACCEPTED
  CANCELLED
  DELETED
}

enum PredictionCategory {
  RESULT
  GOALS
  CORNERS
}

model PredictionGroup {
  id                   String                 @id @default(uuid())
  status               PredictionGroupStatus  @default(PREVIEW)
  targetDate           DateTime
  description          String                 @db.Text
  backgroundVideo      String                 @default("background_video_1.mp4")
  backgroundAudio      String                 @default("background_track_1.mp3")
  voiceActor           String                 @default("hearth")
  thumbnailTimestamp   Float                  @default(5.0)
  scheduledPostTime    DateTime?
  
  groupOutcome         String                 @default("PENDING") // PENDING, HIT, MISS
  validationNotes      String?                @db.Text
  validationCheckedAt  DateTime?

  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt

  games                GamePrediction[]
  socialPipelines      SocialPostPipeline[]

  @@map("prediction_groups")
}

model SocialPostPipeline {
  id           String             @id @default(uuid())
  groupId      String
  group        PredictionGroup    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  status       String             @default("PENDING") // PENDING, RUNNING, COMPLETED, PARTIALLY_FAILED, FAILED
  scheduledFor DateTime?
  startedAt    DateTime?
  completedAt  DateTime?
  logs         String?            @db.Text
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  items        SocialPostItem[]

  @@map("social_post_pipelines")
}

model SocialPostItem {
  id           String             @id @default(uuid())
  pipelineId   String
  pipeline     SocialPostPipeline @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  platform     String             // 'facebook_reels' | 'instagram_reels' | 'tiktok' | 'youtube_shorts'
  status       String             @default("PENDING") // PENDING, IN_PROGRESS, SUCCESS, FAILED
  remotePostId String?            @db.Text
  remoteUrl    String?            @db.Text
  error        String?            @db.Text
  logs         String?            @db.Text
  attemptedAt  DateTime?
  completedAt  DateTime?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  @@map("social_post_items")
}

model GamePrediction {
  id                   String                 @id @default(uuid())
  groupId              String
  group                PredictionGroup        @relation(fields: [groupId], references: [id], onDelete: Cascade)
  
  homeTeam             String
  homeTeamLogo         String?                @db.Text
  awayTeam             String
  awayTeamLogo         String?                @db.Text
  competition          String
  competitionLogo      String?                @db.Text
  kickoffTime          DateTime
  orderIndex           Int                    @default(0)
  reason               String?                @db.Text

  // Real outcome of the game prediction: PENDING, HIT, MISS (set manually from mobile history)
  realOutcome          String                 @default("PENDING") // PENDING, HIT, MISS

  selections           PredictionSelection[]

  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt

  @@map("game_predictions")
}

model PredictionSelection {
  id                   String                 @id @default(uuid())
  gamePredictionId     String
  gamePrediction       GamePrediction         @relation(fields: [gamePredictionId], references: [id], onDelete: Cascade)

  category             PredictionCategory
  code                 String
  label                String
  spokenText           String

  createdAt            DateTime               @default(now())

  @@map("prediction_selections")
}
