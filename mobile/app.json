{
  "expo": {
    "name": "GoalCast Studio",
    "slug": "goalcast-studio",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#020617",
    "primaryColor": "#10b981",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#020617"
    },
    "ios": {
      "supportsTablet": true,
      "backgroundColor": "#020617",
      "splash": {
        "image": "./assets/splash-icon.png",
        "resizeMode": "contain",
        "backgroundColor": "#020617"
      }
    },
    "android": {
      "package": "com.curtismoxebo.goalcaststudio",
      "backgroundColor": "#020617",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#020617"
      },
      "splash": {
        "image": "./assets/splash-icon.png",
        "resizeMode": "contain",
        "backgroundColor": "#020617"
      },
      "permissions": [
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "READ_MEDIA_VIDEO"
      ]
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#020617",
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "dark": {
            "backgroundColor": "#020617",
            "image": "./assets/splash-icon.png"
          }
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Allow GoalCast Studio to save prediction videos to your gallery.",
          "savePhotosPermission": "Allow GoalCast Studio to save prediction videos to your gallery."
        }
      ],
      "expo-asset",
      "expo-font",
      "expo-video",
      "expo-web-browser"
    ],
    "extra": {
      "eas": {
        "projectId": "1ed598d5-4aa0-4a07-ad07-ea1498761b30"
      }
    }
  }
}
